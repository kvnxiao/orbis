{
  "name": "@orbis/plan",
  "version": "0.1.0",
  "description": "Collaborative planning in Pi with terminal and browser review",
  "keywords": [
    "orbis",
    "pi-package"
  ],
  "license": "MIT",
  "files": [
    "src",
    "docs",
    "SPEC.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "pnpm run \"/^typecheck:.*/\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:node": "tsc --noEmit -p tsconfig.json",
    "typecheck:browser": "tsc --noEmit -p src/browser/tsconfig.json"
  },
  "dependencies": {
    "marked": "18.0.5"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@types/node": "catalog:",
    "playwright": "catalog:",
    "typebox": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
